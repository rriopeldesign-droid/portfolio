{
  "name": "riopel-design.github.io",
  "version": "1.0.0",
  "description": "Robert Riopel portfolio",
  "scripts": {
    "build": "npm run build:css && npm run build:motion && npm run build:forest",
    "build:css": "tailwindcss -i src/input.css -o css/style.css --minify",
    "build:motion": "esbuild src/motion-entry.js --bundle --format=esm --minify --target=es2020 --outfile=js/vendor/motion.js",
    "watch": "tailwindcss -i src/input.css -o css/style.css --watch",
    "build:forest": "esbuild src/forest/main.js --bundle --format=esm --minify --target=es2020 --outfile=js/forest.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "motion": "^14.0.0",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
